NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgres://ledgerflow:ledgerflow@localhost:5432/ledgerflow
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# Per-API-key budget per window (authenticated routes).
RATE_LIMIT_MAX=200
# Per-client-IP budget per window (applied before authentication).
RATE_LIMIT_IP_MAX=600
RATE_LIMIT_BOOTSTRAP_MAX=10
RATE_LIMIT_WINDOW_MS=60000
# false | true | <trusted proxy hop count> | comma-separated proxy IPs/CIDRs.
# Only set this when a proxy you control rewrites X-Forwarded-For (Render: 1).
TRUST_PROXY=false
# Worker: exclusive claim window on a webhook delivery row.
WEBHOOK_LEASE_MS=60000
# Worker: expired idempotency-key reaping (0 disables).
IDEMPOTENCY_REAP_INTERVAL_MS=300000
IDEMPOTENCY_REAP_BATCH_SIZE=1000
SHUTDOWN_TIMEOUT_MS=10000

# Webhooks. WEBHOOK_SECRET_KEY is 32 bytes, base64 (`openssl rand -base64 32`);
# it encrypts signing secrets at rest and production refuses the default.
WEBHOOK_SECRET_KEY=
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_BACKOFF_BASE_MS=2000
WEBHOOK_BACKOFF_MAX_MS=3600000
WEBHOOK_CONCURRENCY=10
# SSRF escape hatches for local development only; refused in production.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
WEBHOOK_ALLOW_INSECURE_HTTP=false
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=100
